# Normalize line endings: LF in the repository, native on checkout unless overridden below.
* text=auto eol=lf

# Windows scripts must keep CRLF (cmd.exe mis-parses labels/goto in LF batch files).
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Source
*.py    text diff=python
*.js    text
*.html  text diff=html
*.css   text diff=css
*.json  text
*.md    text diff=markdown
*.txt   text
*.toml  text
*.yml   text
*.yaml  text

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.wav   binary
*.bin   binary
*.exe   binary
*.dll   binary
*.zip   binary
